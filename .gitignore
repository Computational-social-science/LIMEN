__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Never commit a machine-specific path. The declared paths live in the repository's path config; an
# override belongs in the environment, not in the tree, or the tree stops being cloneable elsewhere.
.env
*.local.json

# Generated by the pipeline. These are outputs, never sources; the guard in scripts/check_object_drift.py
# is about retired objects and does not cover them.
measurement/out/
*.items.jsonl
*.trial.jsonl

# paper2agent conversion scratch (working dirs, not deliverables)
.p2a-work/

# Generated manuscript output. The HTML is derived from the anchor and stamped with its
# sha256; the KaTeX distribution is third-party and copied in by the build.
viz/katex/
  # third-party KaTeX distribution, copied in by the build; never hand-edited
viz/manuscript.html
  # generated: rebuild with scripts/build_manuscript_html.py
# NOTE: viz/protocol.md is deliberately NOT ignored. It is the byte-for-byte copy the build
# read, and it is the recovery source - an entire section was once deleted by a bad edit and
# restored from it. A backup excluded from version control is not a backup.
